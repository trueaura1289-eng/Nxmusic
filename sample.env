# ════════════════════════════════════════════════════
#            ShizuMusic — Environment Variables
# ════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────

# Telegram API Credentials
# Get from: https://my.telegram.org
API_ID=
API_HASH=

# Telegram Bot Token
# Get from: @BotFather
BOT_TOKEN=

# Pyrogram String Session
# Generate from your assistant account
STRING_SESSION=

# MongoDB Database URL
# Get free cluster from: https://cloud.mongodb.com
MONGO_DB_URL=

# Your Telegram User ID
OWNER_ID=

# Logger Group / Channel ID
LOGGER_ID=

# ── BOT SETTINGS ────────────────────────────────────

BOT_NAME=
BOT_LINK=

UPDATES_CHANNEL=
SUPPORT_GROUP=

# ── MEDIA ───────────────────────────────────────────

START_ANIMATIONS=https://anya-file-host.vercel.app/5boqhxgtl9
PING_IMG_URL=https://anya-file-host.vercel.app/kznv9qtaxw

# ── SYSTEM ──────────────────────────────────────────

SESSION_NAME=ElyxMusic
PORT=10000

# ── LIMITS ──────────────────────────────────────────

MAX_DURATION_SECONDS=1800
QUEUE_LIMIT=20
COOLDOWN=10
